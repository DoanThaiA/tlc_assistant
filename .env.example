# Sao chép thành .env rồi sửa.
# (Không đặt chú thích cùng dòng với giá trị — docker compose có thể đọc nhầm.)

# --- Domain công khai (dùng khi chạy docker compose trên VPS) ---
# Trỏ bản ghi DNS A của domain này về IP của VPS trước khi chạy.
DOMAIN=mcp.congty.vn
# Email nhận thông báo từ Let's Encrypt (chứng chỉ HTTPS)
LETSENCRYPT_EMAIL=

# --- Server HTTP (khi chạy trực tiếp, không qua Docker) ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Một hoặc nhiều key, cách nhau dấu phẩy. Sinh key: uv run email-report-mcp gen-key
# hoặc: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=

# Domain công khai được phép trong Host header (docker compose tự đặt bằng DOMAIN)
MCP_ALLOWED_HOSTS=

# --- Trang quản trị web (mở https://<domain>/ ; MCP vẫn ở /mcp) ---
# Mật khẩu đăng nhập. Để trống = đăng nhập bằng một API key ở trên.
ADMIN_PASSWORD=
# Khoá ký cookie đăng nhập (tuỳ chọn, để trống = tự suy ra). Đổi giá trị = đăng xuất mọi phiên.
SESSION_SECRET=
# Thời hạn phiên đăng nhập (giờ)
ADMIN_SESSION_HOURS=12

# --- CSDL ---
DB_PATH=data/reports.db

# --- Nghiệp vụ ---
TIMEZONE=Asia/Ho_Chi_Minh
# Ngày phải nộp báo cáo: 1=Thứ 2 ... 7=Chủ nhật (vd làm cả thứ 7: 1,2,3,4,5,6)
WORK_DAYS=1,2,3,4,5
